# ---------------------------------------------------------------------------
# Modèle de configuration — CE FICHIER EST VERSIONNÉ, il ne doit contenir
# AUCUN secret réel : uniquement les noms de variables, leur rôle, et des
# valeurs d'exemple ou des placeholders.
#
# Usage :
#     .claude/skills/project-init/init.sh init     # crée .env à partir d'ici
#     .claude/skills/project-init/init.sh check    # vérifie .env vs ce modèle
#
# Format : CLE=valeur, sans espace autour du "=" et SANS guillemets — le
# parseur de scripts/upload_to_superset.py ne les retire pas, ils feraient
# partie de la valeur.
# ---------------------------------------------------------------------------

# --- GitHub ---
# Authentification git vers le dépôt distant.
# Requis uniquement pour pousser des commits (push/pull authentifié).
GITHUB_LOGIN=
GITHUB_USERNAME=
GITHUB_PASSWORD=
# Personal Access Token (scope `repo`). C'est lui qu'utilise git, pas le mot de passe.
GITHUB_TOKEN=

# --- Apache Superset (destination des uploads) ---
# URL de Superset vue DEPUIS LE CONTENEUR superset-uploader : c'est un hostname
# du réseau docker `superset-docker_default`, pas localhost.
# Défaut si absent : http://localhost:8088
SUPERSET_URL=http://superset_app:8088

# URL de Superset vue depuis le navigateur de l'hôte. Sert uniquement au lien
# cliquable affiché en fin d'upload. Défaut si absent : valeur de SUPERSET_URL.
SUPERSET_PUBLIC_URL=http://localhost:8088

# Compte Superset utilisé par le tool d'upload. Défaut si absent : admin
SUPERSET_USERNAME=admin

# REQUIS — sans lui, upload.sh s'arrête sur
# "error: no Superset password found". C'est l'ADMIN_PASSWORD de la stack
# Superset, généré aléatoirement à l'installation et lisible dans
# <clone superset-docker>/CREDENTIALS.txt ou <clone>/docker/.env-local.
SUPERSET_PASSWORD=

# Nom de la connexion base de données cible dans Superset (distincte de la
# metadata DB `superset`). Créée automatiquement si absente, à condition que
# SUPERSET_UPLOAD_SQLALCHEMY_URI soit renseignée. Défaut si absent : uploads
SUPERSET_UPLOAD_DATABASE=uploads

# URI SQLAlchemy servant à créer cette connexion si elle n'existe pas encore.
# Le mot de passe est le POSTGRES_PASSWORD de la stack Superset ; l'hôte
# `superset_db` n'est résolvable que depuis le réseau docker.
SUPERSET_UPLOAD_SQLALCHEMY_URI=postgresql+psycopg2://superset:CHANGEME@superset_db:5432/uploads
